# Copy to .env.e2e and fill with a real active user (e.g. DEFAULT_MAIL / DEFAULT_PASS from backend).
E2E_USER_EMAIL=admin@example.com
E2E_USER_PASSWORD=changeme

# API used by Playwright Node helpers for login (backend must be running).
E2E_API_URL=http://localhost:5000

# Optional — frontend base URL (Playwright webServer / baseURL).
# E2E_BASE_URL=http://localhost:5173
